# Data and artifacts never enter the history.
data/
!data/.gitkeep
# `results/*` and not `results/`: git does not descend into an excluded
# directory, so a negation below one never matches. Written as `results/`
# the exception was silently dead and no summary table ever reached the
# history, which is the opposite of the stated policy.
results/*
!results/summary/
outputs/
wandb/
runs/
checkpoints/
*.ckpt
*.pt
*.pth
*.h5
*.npz
*.parquet
*.feather

# Secrets. The .example template is the one exception: it carries the
# variable names and no values, so it belongs in the repo.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS and editor
.DS_Store
.idea/
.vscode/

# -- The consoles and the service around the package ------------------------
node_modules/
.next/
target/
*.tsbuildinfo

# Claude Code session scratch. CLAUDE.md section 0 requires that no AI tooling
# appears in the repository or its metadata; a resume checkpoint carrying a
# session id was committed once and is ignored here so it cannot recur.
.claude/RESUME.md
.claude/checkpoint-*
.claude/settings.local.json
