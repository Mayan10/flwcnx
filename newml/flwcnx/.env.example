# Copy to .env and fill in. .env is gitignored and must
# never be committed, pasted into a chat, or written into a config snapshot.
#
# Register free at https://www.space-track.org/auth/createAccount
# Needed for historical orbital elements: the WetLinks measurements run
# September 2023 to March 2024, CelesTrak serves only current elements, and
# CelesTrak is unreachable from this machine in any case.

SPACETRACK_USER=
SPACETRACK_PASS=
